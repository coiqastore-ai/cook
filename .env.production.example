# Production env file for VPS
# Copy to .env on the server and fill in real values

# Postgres password (БД создаётся с этим паролем)
POSTGRES_PASSWORD=измени_на_надёжный_пароль

# DATABASE_URL подставляется автоматически в docker-compose.prod.yml
# (использует POSTGRES_PASSWORD выше)

# Telegram
BOT_TOKEN=получить_у_@BotFather

# Mini App URL — для бот-кнопки и редиректа после OAuth
MINIAPP_URL=https://cook.coiqa.ru

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL_FAST=deepseek/deepseek-chat
OPENROUTER_MODEL_SMART=google/gemini-2.5-flash

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ВАЖНО: redirect URI должен быть на коде coiqa.ru/api/calendar/oauth/callback
# и быть прописан в Google Cloud Console точно так же
GOOGLE_REDIRECT_URI=https://cook.coiqa.ru/api/calendar/oauth/callback
